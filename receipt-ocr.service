[Unit]
Description=Cold store receipt OCR API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/receipt-ocr
EnvironmentFile=/etc/receipt-ocr.env
ExecStart=/home/ubuntu/receipt-ocr/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
